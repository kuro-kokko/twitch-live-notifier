{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twitch-live-notifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-14",
  // シークレット(TWITCH_SECRET / DISCORD_WEBHOOK_URL)は `wrangler secret put` で登録する。
  // ローカル開発時は .dev.vars に書く(.dev.vars.example を参照)。
  "kv_namespaces": [
    {
      "binding": "NOTIFY_KV",
      // `npx wrangler kv namespace create NOTIFY_KV` で表示された id に置き換える
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
